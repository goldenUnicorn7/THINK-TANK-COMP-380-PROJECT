<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>
<!--
Class Name: SearchView
Date: August 4, 2026
Co-Programmer: Jose Beltran

Description: This is the SearchView.fxml file, which is the view for the search screen. 
It contains a TextField for searching cars, a TableView for displaying the search results, 
and buttons for adding to cart and going back to the main menu.

@co-authored Jose Beltran
@version 1.0
-->

<AnchorPane prefHeight="500.0" prefWidth="750.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="frontend.SearchViewController">

    <children>
        <Text layoutX="300.0" layoutY="55.0" text="Search Cars">
            <font>
                <Font name="Georgia" size="30.0" />
            </font>
        </Text>

        <TextField fx:id="searchField" layoutX="190.0" layoutY="95.0" prefHeight="30.0" prefWidth="280.0" promptText="Search cars">
         <font>
            <Font name="Georgia" size="12.0" />
         </font></TextField>

        <Button layoutX="490.0" layoutY="95.0" mnemonicParsing="false" onAction="#searchCars" text="Search">
         <font>
            <Font name="Georgia" size="12.0" />
         </font></Button>

        <TableView fx:id="carTableView" layoutX="75.0" layoutY="150.0" prefHeight="250.0" prefWidth="600.0">

            <columns>
                <TableColumn fx:id="carColumn" prefWidth="150.0" text="Car" />
                <TableColumn fx:id="modelColumn" prefWidth="150.0" text="Model" />
                <TableColumn fx:id="priceColumn" prefWidth="150.0" text="Price" />
                <TableColumn fx:id="availabilityColumn" prefWidth="150.0" text="Availability" />
            </columns>
        </TableView>

        <!-- TableView is planned to be replaced with a TilePane for better visual representation 
        of cars, but currently commented out due WIP. 
        <ScrollPane layoutX="50.0" layoutY="225.0" prefHeight="850.0" prefWidth="825.0" fitToWidth="true">
            <content>
               <TilePane fx:id="carContainer" hgap="20.0" vgap="20.0" prefColumns="2" prefTileHeight="220.0" prefTileWidth="350.0" style="-fx-padding: 15;" />
            </content>
         </ScrollPane>-->

        <!--This is for the car image in the search screen, image is in img folder-->
        <ImageView fx:id="myImageView" fitHeight="100.0" fitWidth="150.0" layoutX="575.0" layoutY="20.0" preserveRatio="true">
                   <image>
                       <Image url="@img/ford_must.png" />
                     </image>
        </ImageView>


        <Button layoutX="536.0" layoutY="430.0" mnemonicParsing="false" onAction="#addToCart" text="Add to Cart">
         <font>
            <Font name="Georgia" size="12.0" />
         </font></Button>    

        <Button layoutX="151.0" layoutY="430.0" mnemonicParsing="false" onAction="#goToMainMenu" text="Main Menu">
         <font>
            <Font name="Georgia" size="12.0" />
         </font></Button>
      <ImageView fx:id="logoImageView" fitHeight="161.0" fitWidth="157.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@img/logo.png" />
         </image>
      </ImageView>
    </children>
</AnchorPane>
