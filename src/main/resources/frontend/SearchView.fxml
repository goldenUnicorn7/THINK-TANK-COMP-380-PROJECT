<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<AnchorPane prefHeight="500.0" prefWidth="750.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="frontend.SearchViewController">

    <children>
        <Text layoutX="300.0" layoutY="55.0" text="Search Cars">
            <font>
                <Font size="30.0" />
            </font>
        </Text>

        <TextField fx:id="searchField"
                   layoutX="190.0"
                   layoutY="95.0"
                   prefHeight="30.0"
                   prefWidth="280.0"
                   promptText="Search cars" />

        <Button layoutX="490.0"
                layoutY="95.0"
                mnemonicParsing="false"
                text="Search"
                onAction="#searchCars" />

        <TableView fx:id="carTableView"
                   layoutX="75.0"
                   layoutY="150.0"
                   prefHeight="250.0"
                   prefWidth="600.0">

            <columns>
                <TableColumn fx:id="carColumn" prefWidth="150.0" text="Car" />
                <TableColumn fx:id="modelColumn" prefWidth="150.0" text="Model" />
                <TableColumn fx:id="priceColumn" prefWidth="150.0" text="Price" />
                <TableColumn fx:id="availabilityColumn" prefWidth="150.0" text="Availability" />
            </columns>
        </TableView>

        <!--This is for the car image in the search screen, image is in img folder-->
        <ImageView fx:id="myImageView"
                   layoutX="575.0"
                   layoutY="20.0"
                   fitHeight="100.0"
                   fitWidth="150.0" 
                   preserveRatio="true" >
                   <image>
                       <Image url="@img/ford_must.png" />
                     </image>
        </ImageView>


        <Button layoutX="210.0"
                layoutY="430.0"
                mnemonicParsing="false"
                text="Add to Cart"
                onAction="#addToCart" />    

        <Button layoutX="390.0"
                layoutY="430.0"
                mnemonicParsing="false"
                text="Main Menu"
                onAction="#goToMainMenu" />
    </children>
</AnchorPane>