<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="frontend.AvailableCarsController"
            prefHeight="600.0"
            prefWidth="950.0">

    <children>
        <VBox spacing="15.0"
              AnchorPane.topAnchor="20.0"
              AnchorPane.leftAnchor="20.0"
              AnchorPane.rightAnchor="20.0"
              AnchorPane.bottomAnchor="20.0">

            <padding>
                <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
            </padding>

            <Label text="Available Cars">
                <font>
                    <Font size="28.0"/>
                </font>
            </Label>

            <HBox spacing="10.0">
                <TextField fx:id="searchField"
                           promptText="Search by brand or model"
                           prefWidth="300.0"/>

                <Button fx:id="searchButton"
                        text="Search"
                        prefWidth="100.0"
                        onAction="#searchCars"/>

                <Button text="Refresh"
                        prefWidth="100.0"
                        onAction="#refreshCars"/>
            </HBox>

            <TableView fx:id="availableCarsTable"
                       prefHeight="400.0"
                       prefWidth="900.0"
                       VBox.vgrow="ALWAYS">

                <columns>
                    <TableColumn fx:id="carIdColumn"
                                 text="Car ID"
                                 prefWidth="80.0"/>

                    <TableColumn fx:id="brandColumn"
                                 text="Brand"
                                 prefWidth="140.0"/>

                    <TableColumn fx:id="modelColumn"
                                 text="Model"
                                 prefWidth="140.0"/>

                    <TableColumn fx:id="colorColumn"
                                 text="Color"
                                 prefWidth="110.0"/>

                    <TableColumn fx:id="yearColumn"
                                 text="Year"
                                 prefWidth="90.0"/>

                    <TableColumn fx:id="priceColumn"
                                 text="Price / Day"
                                 prefWidth="120.0"/>

                    <TableColumn fx:id="statusColumn"
                                 text="Availability"
                                 prefWidth="150.0"/>
                </columns>
            </TableView>

            <Label fx:id="messageLabel"
                   text=""
                   style="-fx-text-fill: red; -fx-font-size: 14px;"/>

            <HBox spacing="15.0">
                <Button fx:id="addToCartButton"
                        text="Add To Cart"
                        prefWidth="140.0"
                        onAction="#addSelectedCarToCart"/>

                <Button fx:id="goToCartButton"
                        text="Go To Cart"
                        prefWidth="140.0"
                        onAction="#goToCartScreen"/>

                <Button fx:id="backButton"
                        text="Back"
                        prefWidth="100.0"
                        onAction="#goBackToMainPage"/>
            </HBox>
        </VBox>
    </children>
</AnchorPane>