<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="frontend.AddToCartController"
            prefHeight="400.0"
            prefWidth="600.0">

   <children>

      <Label alignment="CENTER"
             layoutY="14.0"
             prefHeight="39.0"
             prefWidth="600.0"
             text="Your Item Has Been Added To Cart">
         <font>
            <Font size="27.0" />
         </font>
      </Label>

      <Label layoutX="60.0"
             layoutY="138.0"
             text="Continue Shopping">
         <font>
            <Font size="21.0" />
         </font>
      </Label>

      <Label layoutX="355.0"
             layoutY="138.0"
             text="Go To Your Cart">
         <font>
            <Font size="21.0" />
         </font>
      </Label>

      <Button fx:id="goBackToStore"
              layoutX="124.0"
              layoutY="175.0"
              mnemonicParsing="false"
              text="Back"
              onAction="#goToAvailableCars" />

      <Button fx:id="goToCart"
              layoutX="404.0"
              layoutY="175.0"
              mnemonicParsing="false"
              text="Go To Cart"
              onAction="#goToCartScreen" />

      <Label fx:id="messageLabel"
             layoutX="180.0"
             layoutY="250.0"
             prefWidth="250.0"
             alignment="CENTER"
             text="" />

   </children>
</AnchorPane>