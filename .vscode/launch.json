{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Launch JavaFX App",
            "request": "launch",
            "mainClass": "frontend.Main",
            "classPaths": [
                "${workspaceFolder}/src",
                "${workspaceFolder}/target/classes", //This was for my machine, if runs without it, you can remove it
                "${workspaceFolder}/library/mysql-connector-j-9.6.0.jar",
                "C:/javafx-sdk-21.0.11/lib/*"
            ],
            "vmArgs": "--module-path \"C:/javafx-sdk-21.0.11/lib\" --add-modules javafx.controls,javafx.fxml"
        }
    ]
}