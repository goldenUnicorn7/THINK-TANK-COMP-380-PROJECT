<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="frontend.ConfirmationScreenController">

    <children>
        <Label alignment="CENTER" layoutX="250.0" layoutY="51.0" prefHeight="50.0" prefWidth="400.0" text="Thank you for your order!">
            <font>
                <Font name="Georgia" size="33.0" />
            </font>
            </Label>

        <Label fx:id="receiptLabel" alignment="CENTER" layoutX="250.0" layoutY="120.0" prefHeight="35.0" prefWidth="400.0" text="Your Receipt">
            <font>
                <Font name="Georgia" size="28.0" />
            </font>
        </Label>

        <TableView fx:id="receiptTable" layoutX="150.0" layoutY="170.0" prefHeight="250.0" prefWidth="600.0">

            <columns>
                <TableColumn fx:id="brandColumn" prefWidth="120.0" text="Brand" />
                <TableColumn fx:id="modelColumn" prefWidth="120.0" text="Model" />
                <TableColumn fx:id="priceColumn" prefWidth="120.0" text="Price" />
                <TableColumn fx:id="daysColumn" prefWidth="100.0" text="Days" />
                <TableColumn fx:id="totalPriceColumn" prefWidth="120.0" text="Total" />
            </columns>
        </TableView>

        <Button fx:id="returnToMainButton" layoutX="325.0" layoutY="460.0" mnemonicParsing="false" onAction="#goToMainPage" prefHeight="35.0" prefWidth="100.0" text="Main Menu">
         <font>
            <Font name="Georgia" size="12.0" />
         </font></Button>

        <Button fx:id="returnToSearchButton" layoutX="465.0" layoutY="460.0" mnemonicParsing="false" onAction="#goToSearch" prefHeight="35.0" prefWidth="100.0" text="Search Cars">
         <font>
            <Font name="Georgia" size="12.0" />
         </font></Button>

    </children>
</AnchorPane>
