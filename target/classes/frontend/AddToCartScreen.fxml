<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="frontend.AddToCartController">

   <children>

      <Label alignment="CENTER" layoutY="33.0" prefHeight="39.0" prefWidth="600.0" text="Your Item Has Been Added To Cart">
         <font>
            <Font name="Georgia" size="27.0" />
         </font>
      </Label>

      <Label layoutX="79.0" layoutY="163.0" text="Continue Shopping">
         <font>
            <Font name="Georgia" size="21.0" />
         </font>
      </Label>

      <Label layoutX="355.0" layoutY="163.0" text="Go To Your Cart">
         <font>
            <Font name="Georgia" size="21.0" />
         </font>
      </Label>

      <Button fx:id="goBackToStore" layoutX="147.0" layoutY="200.0" mnemonicParsing="false" onAction="#goToAvailableCars" text="Back">
         <font>
            <Font name="Georgia" size="12.0" />
         </font></Button>

      <Button fx:id="goToCart" layoutX="394.0" layoutY="200.0" mnemonicParsing="false" onAction="#goToCartScreen" text="Go To Cart">
         <font>
            <Font name="Georgia" size="12.0" />
         </font></Button>

      <Label fx:id="messageLabel" alignment="CENTER" layoutX="180.0" layoutY="250.0" prefWidth="250.0" text="" />

   </children>
</AnchorPane>
