            <Font name="Georgia" size="28.0" />
         </font>
      </Label>

      <Label alignment="CENTER" layoutY="55.0" prefHeight="35.0" prefWidth="600.0" text="Create a New Account!">
         <font>
            <Font name="Georgia" size="24.0" />
         </font>
      </Label>

      <Label layoutX="88.0" layoutY="137.0" text="Enter a Valid Email:">
         <font>
            <Font name="Georgia" size="14.0" />
         </font></Label>

      <TextField fx:id="registerEmail" layoutX="225.0" layoutY="133.0" promptText="Email address">
         <font>
            <Font name="Georgia" size="12.0" />
         </font></TextField>

      <Label layoutX="92.0" layoutY="179.0" text="Create a Password:">
         <font>
            <Font name="Georgia" size="14.0" />
         </font></Label>

      <PasswordField fx:id="registerPassword" layoutX="225.0" layoutY="176.0" promptText="Password">
         <font>
            <Font name="Georgia" size="12.0" />
