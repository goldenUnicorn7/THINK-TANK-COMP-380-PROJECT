      <Button fx:id="signInButton" layoutX="103.0" layoutY="293.0" mnemonicParsing="false" onAction="#goToSignInScreen" text="Sign In">
         <font>
            <Font name="Georgia" size="12.0" />
         </font></Button>

      <Label layoutX="403.0" layoutY="266.0" prefHeight="17.0" prefWidth="103.0" text="Confirm Account:">
         <font>
