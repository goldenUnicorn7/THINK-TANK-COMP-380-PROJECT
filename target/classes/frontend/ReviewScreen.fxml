<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.TextArea?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="frontend.CustomerReviewController">
    <children>
        <Label alignment="CENTER" layoutX="-1.0" layoutY="60.0" prefHeight="50.0" prefWidth="900.0" text="Customer Reviews">
            <font>
                <Font name="Georgia" size="36.0" />
            </font>
        </Label>

      <!--  <TableView fx:id="reviewTable" layoutX="150.0" layoutY="170.0" prefHeight="250.0" prefWidth="600.0">
            <columns>
                <TableColumn fx:id="customerColumn" prefWidth="200.0" text="Customer Name" />
                <TableColumn fx:id="reviewColumn" prefWidth="400.0" text="Review" />
            </columns>
        </TableView> -->
        <TextArea fx:id="reviewTextArea" layoutX="150.0" layoutY="170.0" prefHeight="100.0" prefWidth="600.0" promptText="Write your review here..." wrapText="true">
         <font>
            <Font name="Georgia" size="12.0" />
         </font></TextArea>

        <Button fx:id="returnToMainButton" layoutX="600.0" layoutY="454.0" mnemonicParsing="false" onAction="#goToMainPage" prefHeight="35.0" prefWidth="100.0" text="Main Menu">
         <font>
            <Font name="Georgia" size="12.0" />
         </font></Button>

      <ImageView fx:id="logoImageView" fitHeight="180.0" fitWidth="180.0" layoutX="359.0" layoutY="420.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@img/logo.png" />
         </image>
      </ImageView>

    </children>
</AnchorPane>