<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="frontend.CartViewController">

    <children>
        <VBox alignment="CENTER" spacing="20.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">

            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>

            <Label text="Your Cart">
                <font>
                    <Font name="Georgia" size="30.0" />
                </font>
            </Label>

            <TableView fx:id="cartTable" prefHeight="320.0" prefWidth="650.0">

                <columns>
                    <TableColumn fx:id="carColumn" prefWidth="160.0" text="Car" />

                    <TableColumn fx:id="modelColumn" prefWidth="160.0" text="Model" />

                    <TableColumn fx:id="daysColumn" prefWidth="140.0" text="Days" />

                    <TableColumn fx:id="totalColumn" prefWidth="160.0" text="Total" />
                </columns>
            </TableView>

            <Label fx:id="messageLabel" style="-fx-text-fill: red; -fx-font-size: 14px;" text="" />

            <HBox alignment="CENTER" prefHeight="23.0" prefWidth="1149.0" spacing="20.0">

                <Button fx:id="mainMenuButton" onAction="#goToMainMenu" prefWidth="120.0" text="Main Menu">
               <font>
                  <Font name="Georgia" size="12.0" />
               </font></Button>

                <Button fx:id="availableCarsButton" onAction="#goToAvailableCars" prefWidth="130.0" text="Available Cars">
               <font>
                  <Font name="Georgia" size="12.0" />
               </font></Button>

                <Button fx:id="removeButton" onAction="#removeSelectedCar" prefWidth="100.0" text="Remove">
               <font>
                  <Font name="Georgia" size="12.0" />
               </font></Button>

                <Button fx:id="checkoutButton" onAction="#checkout" prefWidth="100.0" text="Checkout">
               <font>
                  <Font name="Georgia" size="12.0" />
               </font></Button>

            </HBox>

        </VBox>
    </children>
</AnchorPane>
