<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="frontend.CartViewController"
            prefHeight="600.0"
            prefWidth="800.0">

    <children>
        <VBox alignment="CENTER"
              spacing="20.0"
              AnchorPane.topAnchor="20.0"
              AnchorPane.bottomAnchor="20.0"
              AnchorPane.leftAnchor="20.0"
              AnchorPane.rightAnchor="20.0">

            <padding>
                <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
            </padding>

            <Label text="Your Cart">
                <font>
                    <Font size="30.0"/>
                </font>
            </Label>

            <TableView fx:id="cartTable"
                       prefHeight="320.0"
                       prefWidth="650.0">

                <columns>
                    <TableColumn fx:id="carColumn"
                                 text="Car"
                                 prefWidth="160.0"/>

                    <TableColumn fx:id="modelColumn"
                                 text="Model"
                                 prefWidth="160.0"/>

                    <TableColumn fx:id="daysColumn"
                                 text="Days"
                                 prefWidth="140.0"/>

                    <TableColumn fx:id="totalColumn"
                                 text="Total"
                                 prefWidth="160.0"/>
                </columns>
            </TableView>

            <Label fx:id="messageLabel"
                   text=""
                   style="-fx-text-fill: red; -fx-font-size: 14px;"/>

            <HBox alignment="CENTER"
                  spacing="20.0">

                <Button fx:id="mainMenuButton"
                        text="Main Menu"
                        prefWidth="120.0"
                        onAction="#goToMainMenu"/>

                <Button fx:id="availableCarsButton"
                        text="Available Cars"
                        prefWidth="130.0"
                        onAction="#goToAvailableCars"/>

                <Button fx:id="removeButton"
                        text="Remove"
                        prefWidth="100.0"
                        onAction="#removeSelectedCar"/>

                <Button fx:id="checkoutButton"
                        text="Checkout"
                        prefWidth="100.0"
                        onAction="#checkout"/>

            </HBox>

        </VBox>
    </children>
</AnchorPane>